{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "beta": {
      "distribution": "store",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "ORCA_IOS_APS_ENVIRONMENT": "production"
      }
    },
    "beta-simulator": {
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "env": {
        "ORCA_IOS_APS_ENVIRONMENT": "production"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "ORCA_IOS_APS_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "ascAppId": "6831536005"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {}
  }
}
